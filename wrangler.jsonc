{
  // Miku Monday Bot on Cloudflare Workers (webhook + Cron Triggers + Supabase via Hyperdrive). Replaces server.js on Zeabur.
  // Data: schema miku_monday in the shared Supabase project (TheBooleanJulian/thebooleanjulian-db); the Hyperdrive
  // config "miku-monday-db" logs in as miku_monday_app, which can only touch that schema.
  // Secrets: BOT_TOKEN, WEBHOOK_SECRET, DEVELOPER_CHAT_ID (moved from Zeabur with zeabur-migration/push_secrets.py).
  // Cutover: register the webhook once —
  //   curl "https://api.telegram.org/bot<BOT_TOKEN>/setWebhook" -d url=https://miku-monday.thebooleanjulian.dev/webhook -d secret_token=<WEBHOOK_SECRET>
  "name": "miku-monday",
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_URL": "https://miku-monday.thebooleanjulian.dev",
    "BOT_USERNAME": "itsmikumondaybot"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "193a949a4e394c76986b92ab79bb7ba2" }],
  "triggers": { "crons": ["0 16 * * SUN", "0 16 * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/webhook", "/health", "/healthz", "/status", "/brand/*", "/api/*"]
  },
  "routes": [{ "pattern": "miku-monday.thebooleanjulian.dev", "custom_domain": true }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true }
}
